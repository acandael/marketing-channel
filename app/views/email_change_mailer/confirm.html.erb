<!DOCTYPE html>
<html>
  <body style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif; background: #fafaf9; padding: 32px; color: #1a1a1a;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width: 560px; margin: 0 auto; background: #ffffff; border: 1px solid #e5e5e4; border-radius: 12px; padding: 32px;">
      <tr>
        <td>
          <h1 style="margin: 0 0 16px; font-size: 22px;">Confirm your new email</h1>
          <p style="line-height: 1.5; color: #4a4a48;">
            We received a request to change the email on your Marketing Channel account from
            <strong><%= @user.email_address %></strong> to <strong><%= @user.pending_email_address %></strong>.
          </p>
          <p style="margin: 24px 0;">
            <a href="<%= @confirm_url %>"
               style="display: inline-block; background: #4a9c58; color: #ffffff; padding: 12px 22px; border-radius: 8px; font-weight: 600; text-decoration: none;">
              Confirm new email
            </a>
          </p>
          <p style="font-size: 13px; color: #6b6b68; line-height: 1.5;">
            Or paste this link:<br>
            <a href="<%= @confirm_url %>" style="color: #40914d; word-break: break-all;"><%= @confirm_url %></a>
          </p>
          <p style="font-size: 13px; color: #6b6b68; margin-top: 16px;">
            This link expires on <strong><%= @expires_at.strftime("%-d %B %Y at %H:%M") %></strong>. If you didn't request this change, you can safely ignore this email.
          </p>
        </td>
      </tr>
    </table>
  </body>
</html>
