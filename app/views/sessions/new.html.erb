<% content_for :title, "Anmelden" %>

<div class="auth-shell">
  <div class="auth-card">
    <h1 class="auth-card__title">Anmelden</h1>
    <%= render "shared/flash" %>

    <%= form_with url: session_path, class: "form" do |f| %>
      <div class="form-field">
        <%= f.label :email_address, "E-Mail-Adresse", class: "form-field__label" %>
        <%= f.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address], class: "form-field__input" %>
      </div>
      <div class="form-field">
        <%= f.label :password, "Passwort", class: "form-field__label" %>
        <%= f.password_field :password, required: true, autocomplete: "current-password", maxlength: 72, class: "form-field__input" %>
      </div>
      <%= f.submit "Anmelden", class: "btn btn--primary" %>
    <% end %>

    <p class="auth-card__footer">
      <%= link_to "Passwort vergessen?", new_password_path %>
    </p>
  </div>
</div>
