<% content_for :title, "Finden Sie Ihren Naturheilpraktiker" %>
<% content_for :description, "Nehmen Sie Kontakt zu vertrauenswürdigen Experten für ganzheitliches Wohlbefinden in ganz Deutschland auf. Suchen Sie nach Fachgebiet oder Standort." %>

<section class="hero">
  <div class="wrapper hero__wrapper">
    <div class="hero__text">
      <h1 class="hero__title">
        Finden Sie Ihren <span class="hero__title-accent">Naturheilpraktiker</span>
      </h1>
      <p class="hero__content">
        Nehmen Sie Kontakt zu vertrauenswürdigen Experten für ganzheitliches Wohlbefinden in Ihrer Nähe
        auf. Entdecken Sie eine individuell auf Sie zugeschnittene Betreuung, die Körper, Geist und
        Seele gleichermaßen stärkt.
      </p>
    </div>

    <%= form_with url: root_path, method: :get, class: "hero__search", local: true do %>
      <div class="hero__search-elements">
        <input type="text"
               name="q"
               value="<%= @filters[:q] %>"
               class="hero__search-input hero__search-input--query"
               placeholder="Therapeut oder Fachgebiet"
               aria-label="Therapeut oder Fachgebiet">
        <input type="text"
               name="near"
               value="<%= @filters[:near] %>"
               class="hero__search-input hero__search-input--near"
               placeholder="Region oder Postleitzahl"
               aria-label="Region oder Postleitzahl">
        <button type="submit" class="hero__search-submit">Therapeuten suchen</button>
      </div>
      <p class="hero__search-note">
        Suchen Sie unter den geprüften Naturheilpraktikern im gesamten Netzwerk.
      </p>
    <% end %>
  </div>
</section>

<section class="featured" id="results">
  <div class="wrapper featured__wrapper">
    <div class="featured__text">
      <h2 class="featured__title">
        <%= @searching ? "Suchergebnisse" : "Empfohlene Therapeuten" %>
      </h2>
      <p class="featured__content">
        <% if @searching %>
          <%= pluralize(@pagy.count, "Therapeut", plural: "Therapeuten") %> passend
          <% if @filters[:q].present? %>
            zu <strong><%= @filters[:q] %></strong>
          <% end %>
          <% if @filters[:near].present? %>
            in der Nähe von <strong><%= @filters[:near] %></strong>
          <% end %>·
          <%= link_to "zurücksetzen", root_path %>
        <% else %>
          Experten, die Sie auf Ihrem Weg zu mehr Wohlbefinden begleiten.
        <% end %>
      </p>
    </div>

    <% if @practitioners.any? %>
      <div class="featured__cards">
        <% @practitioners.each do |practitioner| %>
          <%= render "practitioner_card", practitioner: practitioner %>
        <% end %>
      </div>

      <% if @pagy.pages > 1 %>
        <div class="pagination">
          <%== pagy_nav(@pagy) %>
        </div>
      <% end %>
    <% else %>
      <div class="empty-state">
        <h3>Keine Therapeuten gefunden</h3>
        <p class="muted">Versuchen Sie einen anderen Suchbegriff oder setzen Sie die Filter zurück.</p>
        <p class="mt-16"><%= link_to "Filter zurücksetzen", root_path, class: "btn btn--secondary" %></p>
      </div>
    <% end %>
  </div>
</section>
