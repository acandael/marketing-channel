<%= form_with url: root_path, method: :get, class: "search-form", local: true do |f| %>
  <div class="search-form__field">
    <%= f.label :specialty_id, "Specialty", class: "form-field__label" %>
    <%= f.select :specialty_id,
          options_for_select([["Any specialty", ""]] + @specialties.map { |s| [s.name, s.id] }, @filters[:specialty_id]),
          {},
          class: "form-field__select" %>
  </div>

  <div class="search-form__field">
    <%= f.label :q, "City or postal code", class: "form-field__label" %>
    <%= f.text_field :q, value: @filters[:q], class: "form-field__input", placeholder: "e.g. Berlin or 10178" %>
  </div>

  <div class="search-form__actions">
    <%= f.submit "Search", class: "btn btn--primary" %>
  </div>
<% end %>
