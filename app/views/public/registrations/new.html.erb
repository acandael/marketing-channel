<% content_for :title, "Tragen Sie Ihre Praxis ein" %>

<div class="claim-shell">
  <div class="claim-card">
    <h1>Tragen Sie Ihre Praxis ein</h1>
    <p class="muted">
      Teilen Sie uns mit, wer Sie sind und wo Sie praktizieren. Wir senden Ihnen per E-Mail einen Link zu, über den Sie Ihr Passwort festlegen und die Einrichtung Ihres Profils abschließen können.
    </p>

    <%= form_with url: registrations_path, method: :post, scope: :registration, class: "form" do |f| %>
      <div class="form-section">
        <h2 class="form-section__title">Ihr Konto</h2>
        <div class="form-grid">
          <div class="form-field form-field--full">
            <%= f.label :email, "E-Mail-Adresse", class: "form-field__label" %>
            <%= f.email_field :email, value: @form[:email], required: true,
                              autocomplete: "email", class: "form-field__input" %>
            <span class="form-field__hint">Wir senden Ihnen den Bestätigungslink an diese Adresse.</span>
          </div>
        </div>
      </div>

      <div class="form-section">
        <h2 class="form-section__title">Ihre Praxis</h2>
        <div class="form-grid">
          <div class="form-field form-field--full">
            <%= f.label :full_name, "Vollständiger Name", class: "form-field__label" %>
            <%= f.text_field :full_name, value: @form[:full_name], required: true,
                             class: "form-field__input" %>
          </div>
          <div class="form-field form-field--full">
            <%= f.label :street_address, "Straße + Hausnummer", class: "form-field__label" %>
            <%= f.text_field :street_address, value: @form[:street_address],
                             class: "form-field__input" %>
          </div>
          <div class="form-field">
            <%= f.label :postal_code, "Postleitzahl", class: "form-field__label" %>
            <%= f.text_field :postal_code, value: @form[:postal_code],
                             class: "form-field__input", pattern: "\\d{5}",
                             placeholder: "5 Ziffern" %>
          </div>
          <div class="form-field">
            <%= f.label :city, "Ort", class: "form-field__label" %>
            <%= f.text_field :city, value: @form[:city], required: true,
                             class: "form-field__input" %>
          </div>
          <div class="form-field">
            <%= f.label :phone, "Telefon", class: "form-field__label" %>
            <%= f.text_field :phone, value: @form[:phone], class: "form-field__input" %>
          </div>
          <div class="form-field">
            <%= f.label :public_email, "Öffentliche E-Mail-Adresse", class: "form-field__label" %>
            <%= f.email_field :public_email, value: @form[:public_email],
                              class: "form-field__input" %>
            <span class="form-field__hint">Wird in Ihrem Profil angezeigt. Lassen Sie das Feld leer, um die E-Mail-Adresse zu verbergen.</span>
          </div>
          <div class="form-field form-field--full">
            <%= f.label :short_tagline, "Kurzer Slogan", class: "form-field__label" %>
            <%= f.text_field :short_tagline, value: @form[:short_tagline], maxlength: 140,
                             class: "form-field__input" %>
          </div>
          <div class="form-field form-field--full">
            <%= label_tag "registration_specialty_id", "Fachgebiet", class: "form-field__label" %>
            <%= select_tag "registration[specialty_id]",
                  options_from_collection_for_select(@specialties, :id, :name, @form[:specialty_id]),
                  include_blank: "— Wählen Sie eine Option —",
                  class: "form-field__select" %>
            <span class="form-field__hint">Sie können später über Ihr Dashboard weitere Schwerpunkte hinzufügen.</span>
          </div>
        </div>
      </div>

      <div class="form-actions">
        <%= f.submit "Bestätigungs-E-Mail senden", class: "btn btn--primary" %>
      </div>

      <p class="muted text-sm mt-16">
        Neue Einträge werden von einem Administrator geprüft, bevor sie im Verzeichnis veröffentlicht werden.
      </p>
    <% end %>
  </div>
</div>
