<% content_for :title, "Check your email" %>

<div class="claim-shell">
  <div class="claim-card">
    <h1>Check your email</h1>
    <p>
      We've sent a verification link to <strong><%= @sent_to %></strong>. Click it to set your password and finish setting up your listing.
    </p>

    <% if @matched_existing %>
      <div class="flash flash--notice mt-16">
        We found an existing basic listing for this practice. The link will let you claim it.
      </div>
    <% end %>

    <p class="muted text-sm mt-16">
      The link expires in 30 days. Didn't get it? Check spam, or
      <%= link_to "try again", new_registration_path %>.
    </p>

    <p class="mt-16">
      <%= link_to "Back to home", root_path, class: "btn btn--ghost" %>
    </p>
  </div>
</div>
