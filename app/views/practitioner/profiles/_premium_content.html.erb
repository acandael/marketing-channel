<section class="form-section">
  <h2 class="form-section__title">Premium-Inhalte</h2>
  <p class="form-section__hint">Füllen Sie so viele Felder aus, wie Sie möchten — jedes Feld verbessert Ihren Eintrag. Leere Felder erscheinen nicht in Ihrem öffentlichen Profil.</p>

  <div class="form-grid">
    <div class="form-field form-field--full">
      <%= f.label :profile_photo, "Profilfoto", class: "form-field__label" %>
      <% if @practitioner.profile_photo.attached? %>
        <div class="row mb-16" style="gap: 12px;">
          <%= image_tag @practitioner.profile_photo.variant(:thumb), alt: "Aktuelles Foto", class: "photo-preview" %>
          <span class="text-meta">Beim Hochladen eines neuen Fotos wird dieses ersetzt.</span>
        </div>
      <% end %>
      <%= f.file_field :profile_photo, accept: "image/jpeg,image/png,image/webp", class: "form-field__input" %>
      <span class="form-field__hint">JPEG, PNG oder WebP. Bis zu 5&nbsp;MB. Wird bei der Anzeige auf ein zentriertes Quadrat zugeschnitten.</span>
    </div>

    <div class="form-field form-field--full">
      <%= f.label :short_tagline, "Kurzer Slogan", class: "form-field__label" %>
      <%= f.text_field :short_tagline, class: "form-field__input", maxlength: 140, placeholder: "z. B. Klassische Homöopathie in München — Fokus auf Kinder" %>
      <span class="form-field__hint">Eine Zeile, bis zu 140 Zeichen. Wird unter Ihrem Namen angezeigt.</span>
    </div>

    <div class="form-field form-field--full">
      <%= f.label :long_bio, "Über Sie", class: "form-field__label" %>
      <%= f.rich_text_area :long_bio %>
      <span class="form-field__hint">Fettdruck, Kursivschrift, Links und Listen werden unterstützt.</span>
    </div>

    <div class="form-field form-field--full">
      <span class="form-field__label">Behandlungen</span>
      <p class="form-field__hint" style="margin-bottom: 8px;">
        Verwalten Sie Ihr Behandlungsangebot (Titel, Beschreibung, Dauer, Preis) auf der entsprechenden
        <%= link_to "Seite „Behandlungen“", practitioner_treatments_path %>.
      </p>
    </div>

    <div class="form-field form-field--full">
      <span class="form-field__label">Öffnungszeiten</span>
      <div class="opening-hours-grid">
        <% Practitioner::DAYS_OF_WEEK.each do |day| %>
          <% entry = @practitioner.opening_hours_for(day) %>
          <div class="opening-hours-row">
            <span class="opening-hours-row__day"><%= day_label(day) %></span>
            <input type="time"
                   name="practitioner[opening_hours][<%= day %>][open]"
                   value="<%= entry&.dig("open") %>"
                   class="form-field__input"
                   aria-label="<%= day_full_label(day) %> Öffnungszeit">
            <span class="opening-hours-row__sep">–</span>
            <input type="time"
                   name="practitioner[opening_hours][<%= day %>][close]"
                   value="<%= entry&.dig("close") %>"
                   class="form-field__input"
                   aria-label="<%= day_full_label(day) %> Schließzeit">
            <label class="opening-hours-row__closed">
              <input type="hidden" name="practitioner[opening_hours][<%= day %>][closed]" value="0">
              <input type="checkbox"
                     name="practitioner[opening_hours][<%= day %>][closed]"
                     value="1"
                     <%= "checked" if entry.nil? %>>
              Geschlossen
            </label>
          </div>
        <% end %>
      </div>
      <span class="form-field__hint">Markieren Sie einen Tag als „Geschlossen“, wenn Sie an diesem Tag nicht arbeiten.</span>
    </div>

    <div class="form-field form-field--full">
      <%= f.label :qualifications, "Qualifikationen", class: "form-field__label" %>
      <%= f.text_area :qualifications, class: "form-field__textarea", rows: 4, placeholder: "Eine pro Zeile, z. B.&#10;Heilpraktiker-Prüfung&#10;Zertifikat für klassische Homöopathie" %>
      <span class="form-field__hint">Eine Qualifikation pro Zeile.</span>
    </div>

    <div class="form-field form-field--full">
      <span class="form-field__label">Galerie</span>
      <p class="form-field__hint" style="margin-bottom: 8px;">
        Verwalten Sie die Fotos, die in Ihrem öffentlichen Profil angezeigt werden, auf der entsprechenden
        <%= link_to "Seite „Galerie“", practitioner_gallery_images_path %>.
      </p>
    </div>
  </div>
</section>
