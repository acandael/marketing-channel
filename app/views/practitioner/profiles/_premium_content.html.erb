<section class="form-section">
  <h2 class="form-section__title">Premium content</h2>
  <p class="form-section__hint">Fill in as much as you'd like — every field lifts your listing. Empty fields don't appear on your public profile.</p>

  <div class="form-grid">
    <div class="form-field form-field--full">
      <%= f.label :profile_photo, "Profile photo", class: "form-field__label" %>
      <% if @practitioner.profile_photo.attached? %>
        <div class="row mb-16" style="gap: 12px;">
          <%= image_tag @practitioner.profile_photo.variant(:thumb), alt: "Current photo", class: "photo-preview" %>
          <span class="text-meta">Uploading a new photo replaces this one.</span>
        </div>
      <% end %>
      <%= f.file_field :profile_photo, accept: "image/jpeg,image/png,image/webp", class: "form-field__input" %>
      <span class="form-field__hint">JPEG, PNG, or WebP. Up to 5&nbsp;MB. Cropped to a centered square on display.</span>
    </div>

    <div class="form-field form-field--full">
      <%= f.label :short_tagline, class: "form-field__label" %>
      <%= f.text_field :short_tagline, class: "form-field__input", maxlength: 140, placeholder: "e.g. Klassische Homöopathie in München — Fokus auf Kinder" %>
      <span class="form-field__hint">One line, up to 140 characters. Shows below your name.</span>
    </div>

    <div class="form-field form-field--full">
      <%= f.label :long_bio, "About you", class: "form-field__label" %>
      <%= f.rich_text_area :long_bio %>
      <span class="form-field__hint">Bold, italics, links, and lists are supported.</span>
    </div>

    <div class="form-field form-field--full">
      <span class="form-field__label">Treatments</span>
      <p class="form-field__hint" style="margin-bottom: 8px;">
        Manage your treatment menu (title, description, duration, price) on the dedicated
        <%= link_to "Treatments page", practitioner_treatments_path %>.
      </p>
    </div>

    <div class="form-field form-field--full">
      <span class="form-field__label">Opening hours</span>
      <div class="opening-hours-grid">
        <% Practitioner::DAYS_OF_WEEK.each do |day| %>
          <% entry = @practitioner.opening_hours_for(day) %>
          <div class="opening-hours-row">
            <span class="opening-hours-row__day"><%= day_label(day) %></span>
            <input type="time"
                   name="practitioner[opening_hours][<%= day %>][open]"
                   value="<%= entry&.dig("open") %>"
                   class="form-field__input"
                   aria-label="<%= day.humanize %> opening time">
            <span class="opening-hours-row__sep">–</span>
            <input type="time"
                   name="practitioner[opening_hours][<%= day %>][close]"
                   value="<%= entry&.dig("close") %>"
                   class="form-field__input"
                   aria-label="<%= day.humanize %> closing time">
            <label class="opening-hours-row__closed">
              <input type="hidden" name="practitioner[opening_hours][<%= day %>][closed]" value="0">
              <input type="checkbox"
                     name="practitioner[opening_hours][<%= day %>][closed]"
                     value="1"
                     <%= "checked" if entry.nil? %>>
              Closed
            </label>
          </div>
        <% end %>
      </div>
      <span class="form-field__hint">Leave a day marked "Closed" if you don't work then.</span>
    </div>

    <div class="form-field">
      <%= f.label :years_in_practice, "Years in practice", class: "form-field__label" %>
      <%= f.number_field :years_in_practice, class: "form-field__input", min: 0, max: 100 %>
    </div>

    <div class="form-field form-field--full">
      <%= f.label :qualifications, class: "form-field__label" %>
      <%= f.text_area :qualifications, class: "form-field__textarea", rows: 4, placeholder: "One per line, e.g.&#10;Heilpraktiker-Prüfung&#10;Zertifikat für klassische Homöopathie" %>
      <span class="form-field__hint">One qualification per line.</span>
    </div>

    <div class="form-field form-field--full">
      <%= f.label :gallery_images, "Gallery", class: "form-field__label" %>
      <% if @practitioner.gallery_images.attached? %>
        <div class="gallery-preview mb-16">
          <% @practitioner.gallery_images.each do |img| %>
            <%= image_tag img.variant(:thumb), alt: "Gallery image", class: "gallery-preview__img" %>
          <% end %>
        </div>
        <span class="form-field__hint" style="display: block; margin-bottom: 8px;">Uploading new files adds to the gallery. To clear it, contact an admin.</span>
      <% end %>
      <%= f.file_field :gallery_images, accept: "image/jpeg,image/png,image/webp", multiple: true, class: "form-field__input" %>
      <span class="form-field__hint">Up to 10 images total, JPEG/PNG/WebP, 5&nbsp;MB each.</span>
    </div>
  </div>
</section>
