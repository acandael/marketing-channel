<% content_for :title, "Mein Profil bearbeiten" %>

<%= link_to "← Zurück zum Dashboard", practitioner_root_path, class: "back-link" %>

<header class="page-header">
  <div>
    <h1 class="page-header__title">Mein Profil bearbeiten</h1>
    <p class="page-header__subtitle">Aktualisieren Sie die grundlegenden Angaben, die Besucher sehen, und ergänzen Sie die darunter liegenden Premium-Bereiche.</p>
  </div>
</header>

<%= form_with model: @practitioner, url: practitioner_profile_path, method: :patch,
              class: "form", multipart: true do |f| %>
  <% if @practitioner.errors.any? %>
    <div class="flash flash--alert">
      <strong><%= pluralize(@practitioner.errors.count, "Fehler") %> haben das Speichern verhindert:</strong>
      <ul style="margin-top: 8px; margin-left: 20px;"><% @practitioner.errors.full_messages.each do |m| %><li><%= m %></li><% end %></ul>
    </div>
  <% end %>

  <%= render "basic_info", f: f %>
  <%= render "premium_content", f: f %>

  <div class="form-actions">
    <%= f.submit "Änderungen speichern", class: "btn btn--primary" %>
    <%= link_to "Abbrechen", practitioner_root_path, class: "btn btn--ghost" %>
  </div>
<% end %>
