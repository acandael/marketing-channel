<section class="form-section">
  <h2 class="form-section__title">Grundlegende Informationen</h2>
  <p class="form-section__hint">Alles, was ein Besucher benötigt, um Sie zu identifizieren und zu kontaktieren.</p>

  <div class="form-grid">
    <div class="form-field">
      <%= f.label :salutation, "Anrede", class: "form-field__label" %>
      <%= f.select :salutation, [["—", ""]] + Practitioner::SALUTATIONS.map { |s| [s, s] }, {}, class: "form-field__select" %>
    </div>
    <div class="form-field">
      <%= f.label :full_name, "Vollständiger Name", class: "form-field__label" %>
      <%= f.text_field :full_name, class: "form-field__input", required: true %>
    </div>

    <div class="form-field form-field--full">
      <span class="form-field__label">Fachgebiet &amp; Schwerpunkte</span>
      <p class="form-field__hint" style="margin-bottom: 8px;">
        Verwalten Sie diese Angaben auf der entsprechenden
        <%= link_to "Seite „Fachgebiet & Schwerpunkte“", edit_practitioner_specialty_path %>.
      </p>
    </div>

    <div class="form-field">
      <%= f.label :phone, "Telefon", class: "form-field__label" %>
      <%= f.text_field :phone, class: "form-field__input" %>
    </div>
    <div class="form-field">
      <%= f.label :public_email, "Öffentliche E-Mail-Adresse", class: "form-field__label" %>
      <%= f.email_field :public_email, class: "form-field__input" %>
      <span class="form-field__hint">Wird in Ihrem öffentlichen Profil angezeigt — unterscheidet sich von Ihrer Anmelde-E-Mail-Adresse.</span>
    </div>
    <div class="form-field form-field--full">
      <%= f.label :website_url, "Website", class: "form-field__label" %>
      <%= f.url_field :website_url, class: "form-field__input", placeholder: "https://…" %>
    </div>

    <div class="form-field form-field--full">
      <%= f.label :street_address, "Straße & Hausnummer", class: "form-field__label" %>
      <%= f.text_field :street_address, class: "form-field__input" %>
      <span class="form-field__hint">Wenn Sie Ihre Adresse ändern, wird beim Speichern die Geokodierung erneut durchgeführt.</span>
    </div>
    <div class="form-field">
      <%= f.label :postal_code, "Postleitzahl (PLZ)", class: "form-field__label" %>
      <%= f.text_field :postal_code, class: "form-field__input", pattern: "\\d{5}", inputmode: "numeric" %>
    </div>
    <div class="form-field">
      <%= f.label :city, "Stadt (Ort)", class: "form-field__label" %>
      <%= f.text_field :city, class: "form-field__input", required: true %>
    </div>
    <div class="form-field form-field--full">
      <%= f.label :bundesland, "Bundesland", class: "form-field__label" %>
      <%= f.select :bundesland, [["—", ""]] + Practitioner::BUNDESLAENDER.map { |b| [b, b] }, {}, class: "form-field__select" %>
    </div>

    <div class="form-field form-field--full">
      <div class="map-preview"
           data-controller="map"
           data-map-latitude-value="<%= @practitioner.latitude || 51.1657 %>"
           data-map-longitude-value="<%= @practitioner.longitude || 10.4515 %>"
           data-map-has-coordinates-value="<%= @practitioner.coordinates? %>">
        <div class="map-preview__canvas" data-map-target="canvas"></div>
        <p class="map-preview__hint">Die Adresse wird beim Speichern geokodiert. Ziehen Sie den Pin, um den Standort genau anzupassen.</p>
        <p class="map-preview__coords">
          <span data-map-target="coords">
            <% if @practitioner.coordinates? %>
              Lat <%= @practitioner.latitude.to_f.round(6) %>, Lng <%= @practitioner.longitude.to_f.round(6) %>
            <% else %>
              Noch keine Koordinaten — speichern Sie, um die Geokodierung durchzuführen, oder klicken Sie auf die Karte, um einen Pin zu setzen.
            <% end %>
          </span>
        </p>
        <%= f.hidden_field :latitude,  data: { map_target: "latitudeField" } %>
        <%= f.hidden_field :longitude, data: { map_target: "longitudeField" } %>
      </div>
    </div>
  </div>
</section>
