<%= form_with model: treatment,
              url: (treatment.persisted? ? practitioner_treatment_path(treatment) : practitioner_treatments_path),
              method: treatment.persisted? ? :patch : :post,
              class: "form" do |f| %>
  <% if treatment.errors.any? %>
    <div class="flash flash--alert">
      <strong><%= pluralize(treatment.errors.count, "error") %> prevented this from being saved:</strong>
      <ul style="margin-top: 8px; margin-left: 20px;">
        <% treatment.errors.full_messages.each do |m| %><li><%= m %></li><% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-section">
    <h2 class="form-section__title">Details</h2>
    <p class="form-section__hint">Add a title and any details you'd like visitors to see.</p>

    <div class="form-grid">
      <div class="form-field form-field--full">
        <%= f.label :title, class: "form-field__label" %>
        <%= f.text_field :title, class: "form-field__input", required: true, autofocus: true, maxlength: 120 %>
      </div>

      <div class="form-field form-field--full">
        <%= f.label :description, class: "form-field__label" %>
        <%= f.text_area :description, class: "form-field__textarea", rows: 4,
              placeholder: "e.g. 60-minute treatment tailored to your primary complaint." %>
      </div>

      <div class="form-field">
        <%= f.label :duration_minutes, "Duration (minutes)", class: "form-field__label" %>
        <%= f.number_field :duration_minutes, class: "form-field__input", min: 1 %>
      </div>

      <div class="form-field">
        <%= f.label :price_euros, "Price (€)", class: "form-field__label" %>
        <%= f.text_field :price_euros,
              value: treatment.price_euros ? format("%.2f", treatment.price_euros) : nil,
              class: "form-field__input",
              inputmode: "decimal",
              placeholder: "0.00" %>
      </div>
    </div>
  </div>

  <div class="form-actions">
    <%= f.submit(treatment.persisted? ? "Save changes" : "Add treatment", class: "btn btn--primary") %>
    <%= link_to "Cancel", practitioner_treatments_path, class: "btn btn--ghost" %>
  </div>
<% end %>
