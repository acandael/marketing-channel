<% content_for :title, "Behandlungen" %>

<%= link_to "← Zurück zum Dashboard", practitioner_root_path, class: "back-link" %>

<header class="page-header">
  <div>
    <h1 class="page-header__title">Behandlungen</h1>
    <p class="page-header__subtitle">Ihr Behandlungsangebot — was Besucher unter „Angebotene Behandlungen“ in Ihrem öffentlichen Profil sehen.</p>
  </div>
  <%= link_to "Behandlung hinzufügen", new_practitioner_treatment_path, class: "btn btn--primary" %>
</header>

<% if @treatments.any? %>
  <ul class="treatment-list">
    <% @treatments.each do |t| %>
      <li class="treatment-list__item">
        <div class="treatment-list__body">
          <h3 class="treatment-list__title"><%= t.title %></h3>
          <% if t.description.present? %>
            <p class="treatment-list__description"><%= t.description %></p>
          <% end %>
          <% if t.duration_display %>
            <p class="treatment-list__meta"><%= t.duration_display %></p>
          <% end %>
        </div>
        <div class="treatment-list__price-col">
          <% if t.formatted_price %>
            <div class="treatment-list__price"><%= t.formatted_price %></div>
          <% end %>
          <div class="treatment-list__actions">
            <%= link_to "Bearbeiten", edit_practitioner_treatment_path(t), class: "btn btn--ghost btn--sm" %>
            <%= button_to "Löschen", practitioner_treatment_path(t), method: :delete,
                  class: "btn btn--danger btn--sm",
                  form: { style: "display:inline-block" },
                  data: { turbo_confirm: "„#{t.title}“ löschen?" } %>
          </div>
        </div>
      </li>
    <% end %>
  </ul>
<% else %>
  <div class="empty-state">
    <h3>Noch keine Behandlungen</h3>
    <p class="muted">Fügen Sie Ihre erste Behandlung hinzu, damit sie in Ihrem öffentlichen Profil angezeigt wird.</p>
    <p class="mt-16"><%= link_to "Fügen Sie Ihre erste Behandlung hinzu", new_practitioner_treatment_path, class: "btn btn--primary" %></p>
  </div>
<% end %>
