<% content_for :title, "Fachgebiete & Schwerpunkte" %>

<%= link_to "← Zurück zum Dashboard", practitioner_root_path, class: "back-link" %>

<header class="page-header">
  <div>
    <h1 class="page-header__title">Fachgebiete &amp; Schwerpunkte</h1>
    <p class="page-header__subtitle">
      Wählen Sie das Hauptfachgebiet aus, das Ihre Praxis beschreibt, sowie alle Schwerpunkte, die Ihre Arbeit auszeichnen.
    </p>
  </div>
</header>

<%= form_with model: @practitioner, url: practitioner_specialty_path, method: :patch, class: "form" do |f| %>
  <% if @practitioner.errors.any? %>
    <div class="flash flash--alert">
      <strong><%= pluralize(@practitioner.errors.count, "Fehler") %> haben das Speichern verhindert:</strong>
      <ul style="margin-top: 8px; margin-left: 20px;"><% @practitioner.errors.full_messages.each do |m| %><li><%= m %></li><% end %></ul>
    </div>
  <% end %>

  <section class="form-section">
    <h2 class="form-section__title">Fachgebiet</h2>
    <div class="form-grid">
      <div class="form-field form-field--full">
        <%= f.label :specialty_id, "Hauptfachgebiet", class: "form-field__label" %>
        <%= f.select :specialty_id,
              options_from_collection_for_select(@specialties, :id, :name, @practitioner.specialty_id),
              { include_blank: "— Wählen Sie eine Option —" },
              class: "form-field__input" %>
        <span class="form-field__hint">Sie können nur eines auswählen. Fehlt eine Option? Bitten Sie einen Administrator, diese hinzuzufügen.</span>
      </div>
    </div>
  </section>

  <section class="form-section"
           data-controller="tag-input"
           data-tag-input-name-value="practitioner[focus_area_names][]">
    <h2 class="form-section__title">Schwerpunkte</h2>
    <p class="form-section__hint">Fügen Sie spezifische Bereiche hinzu, auf die Sie sich konzentrieren — drücken Sie die Eingabetaste oder ein Komma, um einen neuen Eintrag hinzuzufügen. Vorschläge stammen aus den Schwerpunkten anderer Praktiker.</p>

    <div class="tag-input" data-tag-input-target="container">
      <% @practitioner.focus_areas.alphabetical.each do |fa| %>
        <span class="tag-input__tag" data-tag-input-target="tag">
          <%= fa.name %>
          <button type="button" class="tag-input__remove" data-action="tag-input#remove" aria-label="<%= fa.name %> entfernen">×</button>
          <input type="hidden" name="practitioner[focus_area_names][]" value="<%= fa.name %>">
        </span>
      <% end %>
      <input type="text"
             class="tag-input__field"
             list="focus-area-suggestions"
             placeholder="Geben Sie einen Schwerpunkt ein…"
             data-tag-input-target="field"
             data-action="keydown->tag-input#keydown blur->tag-input#commit">
    </div>

    <datalist id="focus-area-suggestions">
      <% @suggested_focus_areas.each do |fa| %>
        <option value="<%= fa.name %>">
      <% end %>
    </datalist>
  </section>

  <div class="form-actions">
    <%= f.submit "Speichern", class: "btn btn--primary" %>
  </div>
<% end %>
