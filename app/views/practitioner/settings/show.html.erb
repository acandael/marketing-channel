<% content_for :title, "Einstellungen" %>

<%= link_to "← Zurück zum Dashboard", practitioner_root_path, class: "back-link" %>

<header class="page-header">
  <h1 class="page-header__title">Einstellungen</h1>
</header>

<section class="form-section settings-card">
  <h2 class="form-section__title">Passwort ändern</h2>
  <p class="form-section__hint">Sie bleiben auf diesem Gerät angemeldet.</p>

  <%= form_with url: practitioner_settings_path, method: :patch, class: "form", local: true do |f| %>
    <%= hidden_field_tag :section, "password" %>
    <div class="form-field">
      <%= label_tag :current_password, "Aktuelles Passwort", class: "form-field__label" %>
      <%= password_field_tag :current_password, nil, required: true, autocomplete: "current-password", class: "form-field__input" %>
    </div>
    <div class="form-field">
      <%= label_tag :new_password, "Neues Passwort", class: "form-field__label" %>
      <%= password_field_tag :new_password, nil, required: true, minlength: 8, autocomplete: "new-password", class: "form-field__input" %>
      <span class="form-field__hint">Mindestens 8 Zeichen.</span>
    </div>
    <div class="form-field">
      <%= label_tag :new_password_confirmation, "Neues Passwort bestätigen", class: "form-field__label" %>
      <%= password_field_tag :new_password_confirmation, nil, required: true, minlength: 8, autocomplete: "new-password", class: "form-field__input" %>
    </div>
    <%= f.submit "Passwort aktualisieren", class: "btn btn--primary" %>
  <% end %>
</section>

<section class="form-section settings-card">
  <h2 class="form-section__title">E-Mail-Adresse ändern</h2>
  <p class="form-section__hint">
    Ihre aktuelle Anmelde-E-Mail-Adresse lautet <strong><%= Current.user.email_address %></strong>.
    <% if Current.user.pending_email_address.present? && !Current.user.email_change_expired? %>
      Eine Bestätigung wurde an <strong><%= Current.user.pending_email_address %></strong> gesendet — prüfen Sie dieses Postfach, um die Änderung abzuschließen.
    <% end %>
  </p>

  <%= form_with url: practitioner_settings_path, method: :patch, class: "form", local: true do |f| %>
    <%= hidden_field_tag :section, "email" %>
    <div class="form-field">
      <%= label_tag :new_email_address, "Neue E-Mail-Adresse", class: "form-field__label" %>
      <%= email_field_tag :new_email_address, nil, required: true, autocomplete: "email", class: "form-field__input" %>
      <span class="form-field__hint">Wir senden einen Bestätigungslink an diese Adresse. Es ändert sich nichts, bis Sie darauf klicken.</span>
    </div>
    <%= f.submit "Bestätigungslink senden", class: "btn btn--secondary" %>
  <% end %>
</section>

<section class="form-section danger-zone">
  <h2 class="form-section__title">Konto löschen</h2>
  <p class="form-section__hint">
    Löscht Ihren Login. Ihr Praktikerprofil wird als nicht beansprucht markiert und bleibt im Verzeichnis sichtbar, bis ein Administrator es entfernt. Ein Administrator wird benachrichtigt.
    Sie können später erneut eingeladen werden, falls Sie Ihre Meinung ändern.
  </p>

  <%= button_to "Mein Konto löschen", practitioner_account_path,
        method: :delete, class: "btn btn--danger",
        data: { turbo_confirm: "Ihr Konto löschen? Dies kann nicht rückgängig gemacht werden." } %>
</section>
