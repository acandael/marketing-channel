<% content_for :title, "Mein Dashboard" %>

<section class="practitioner-hero">
  <div class="practitioner-hero__avatar">
    <% if @practitioner.profile_photo.attached? %>
      <%= image_tag @practitioner.profile_photo.variant(:square), alt: @practitioner.full_name, class: "practitioner-hero__photo" %>
    <% else %>
      <div class="avatar-large"><%= avatar_initial(@practitioner) %></div>
    <% end %>
  </div>

  <div class="practitioner-hero__body">
    <p class="text-meta">Angemeldet als <%= Current.user.email_address %></p>
    <h1 class="practitioner-hero__name"><%= @practitioner.full_name %></h1>
    <p class="muted"><%= @practitioner.city %><%= " · #{@practitioner.bundesland}" if @practitioner.bundesland.present? %></p>

    <div class="row mt-16" style="gap: 8px;">
      <span class="badge <%= @practitioner.published? ? "badge--published" : "badge--unpublished" %>">
        <%= @practitioner.published? ? "Im Verzeichnis sichtbar" : "Im Verzeichnis ausgeblendet" %>
      </span>
    </div>
  </div>
</section>

<section class="completeness-card">
  <div class="completeness-card__header">
    <h2>Vollständigkeit des Profils</h2>
    <span class="completeness-card__percent"><%= @practitioner.profile_completeness %>%</span>
  </div>
  <div class="completeness-bar" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="<%= @practitioner.profile_completeness %>">
    <div class="completeness-bar__fill" style="width: <%= @practitioner.profile_completeness %>%"></div>
  </div>
  <% missing = @practitioner.missing_premium_fields %>
  <% if missing.any? %>
    <p class="text-meta mt-16">
      Fügen Sie folgende Angaben hinzu, um 100 % zu erreichen: <strong><%= missing.to_sentence %></strong>.
    </p>
  <% else %>
    <p class="text-meta mt-16">Alle Premium-Felder sind ausgefüllt. Sehr gut gemacht.</p>
  <% end %>
</section>

<section class="dashboard-tiles">
  <%= link_to edit_practitioner_profile_path, class: "dashboard-tile" do %>
    <span class="dashboard-tile__label">Profil bearbeiten</span>
    <span class="dashboard-tile__hint">Aktualisieren Sie Ihre Angaben, Ihr Foto, Ihre Biografie, Ihre Öffnungszeiten und vieles mehr.</span>
  <% end %>

  <%= link_to practitioner_treatments_path, class: "dashboard-tile" do %>
    <span class="dashboard-tile__label">Behandlungen (<%= @practitioner.treatments.count %>)</span>
    <span class="dashboard-tile__hint">Verwalten Sie die von Ihnen angebotenen Behandlungen mit Preisen und Dauer.</span>
  <% end %>

  <%= link_to practitioner_gallery_images_path, class: "dashboard-tile" do %>
    <span class="dashboard-tile__label">Galerie (<%= @practitioner.gallery_images.count %>)</span>
    <span class="dashboard-tile__hint">Fügen Sie Fotos zu Ihrem öffentlichen Profil hinzu oder entfernen Sie sie daraus.</span>
  <% end %>

  <%= link_to edit_practitioner_specialty_path, class: "dashboard-tile" do %>
    <span class="dashboard-tile__label">Fachgebiet und Schwerpunkte (<%= @practitioner.focus_areas.count %>)</span>
    <span class="dashboard-tile__hint">Geben Sie Ihr Hauptfachgebiet an und listen Sie die Bereiche auf, auf die Sie sich konzentrieren.</span>
  <% end %>

  <%= link_to public_practitioner_path(@practitioner), class: "dashboard-tile", target: "_blank", rel: "noopener" do %>
    <% if @practitioner.published? %>
      <span class="dashboard-tile__label">Mein öffentliches Profil ansehen ↗</span>
      <span class="dashboard-tile__hint">Öffnet die Seite, die Besucher sehen werden.</span>
    <% else %>
      <span class="dashboard-tile__label">Vorschau meines Profils ↗</span>
      <span class="dashboard-tile__hint">Öffnet die Seite so, wie sie nach der Veröffentlichung erscheinen wird. Nur Sie können sie sehen.</span>
    <% end %>
  <% end %>

  <%= link_to practitioner_settings_path, class: "dashboard-tile" do %>
    <span class="dashboard-tile__label">Einstellungen</span>
    <span class="dashboard-tile__hint">Passwort ändern, E-Mail-Adresse ändern oder Konto löschen.</span>
  <% end %>
</section>

<section class="publish-toggle">
  <h3>Sichtbarkeit im Verzeichnis</h3>
  <p class="text-meta">Legen Sie fest, ob Ihr Eintrag im öffentlichen Verzeichnis angezeigt wird. Ein Administrator kann diese Einstellung überschreiben.</p>
  <% if @practitioner.published? %>
    <%= button_to "Aus dem Verzeichnis ausblenden", practitioner_unpublish_path, method: :patch, class: "btn btn--secondary",
          data: { turbo_confirm: "Ihr Profil aus dem öffentlichen Verzeichnis ausblenden?" } %>
  <% else %>
    <%= button_to "Im Verzeichnis anzeigen", practitioner_publish_path, method: :patch, class: "btn btn--primary" %>
  <% end %>
</section>
