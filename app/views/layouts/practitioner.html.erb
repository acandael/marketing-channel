<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= [content_for(:title).presence || "My dashboard", "Holistic Health"].join(" · ") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
          integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
          crossorigin="">
    <%= stylesheet_link_tag "application", "actiontext", "data-turbo-track": "reload" %>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
            integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
            crossorigin=""></script>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="topnav">
      <div class="wrapper topnav__inner">
        <%= link_to practitioner_root_path, class: "topnav__brand", "aria-label": "Holistic Health — dashboard" do %>
          <%= image_tag "/logo.svg", alt: "Holistic Health", height: 32, class: "topnav__logo" %>
        <% end %>
        <nav class="topnav__nav" aria-label="Practitioner navigation">
          <ul class="topnav__links">
            <li><%= link_to "Dashboard", practitioner_root_path, class: "topnav__link" %></li>
            <li><%= link_to "Edit profile", edit_practitioner_profile_path, class: "topnav__link" %></li>
            <li><%= link_to "Treatments", practitioner_treatments_path, class: "topnav__link" %></li>
            <li><%= link_to "Settings", practitioner_settings_path, class: "topnav__link" %></li>
            <li><%= button_to "Sign out", session_path, method: :delete, class: "topnav__link topnav__link--button" %></li>
          </ul>
        </nav>
      </div>
    </header>

    <main>
      <div class="wrapper">
        <%= render "shared/flash" %>
        <%= yield %>
      </div>
    </main>
  </body>
</html>
