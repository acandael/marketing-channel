<!DOCTYPE html>
<html>
  <head>
    <title><%= [content_for(:title), "Admin", "Marketing Channel"].compact.join(" · ") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
          integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
          crossorigin="">
    <%= stylesheet_link_tag "application", "actiontext", "data-turbo-track": "reload" %>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
            integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
            crossorigin=""></script>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="topnav">
      <div class="wrapper topnav__inner">
        <%= link_to admin_root_path, class: "topnav__brand", "aria-label": "Marketing Channel — admin" do %>
          <%= image_tag "/logo.svg", alt: "Marketing Channel", height: 32, class: "topnav__logo" %>
        <% end %>
        <nav class="topnav__nav" aria-label="Admin navigation">
          <ul class="topnav__links">
            <li><%= link_to "Dashboard",     admin_root_path,          class: "topnav__link" %></li>
            <li><%= link_to "Practitioners", admin_practitioners_path, class: "topnav__link" %></li>
            <li><%= link_to "Specialties",   admin_specialties_path,   class: "topnav__link" %></li>
            <li><%= link_to "Focus areas",   admin_focus_areas_path,   class: "topnav__link" %></li>
            <li><%= button_to "Sign out", session_path, method: :delete, class: "topnav__link topnav__link--button" %></li>
          </ul>
        </nav>
      </div>
    </header>

    <main>
      <div class="wrapper">
        <%= render "shared/flash" %>
        <%= yield %>
      </div>
    </main>
  </body>
</html>
