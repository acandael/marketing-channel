<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= [content_for(:title), "Holistic Health"].compact_blank.join(" · ") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <% if content_for?(:description) %>
      <meta name="description" content="<%= content_for(:description) %>">
    <% end %>
    <% if content_for?(:canonical) %>
      <link rel="canonical" href="<%= content_for(:canonical) %>">
    <% end %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
          integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
          crossorigin="">
    <%= stylesheet_link_tag "application", "actiontext", "data-turbo-track": "reload" %>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
            integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
            crossorigin=""></script>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="topnav">
      <div class="wrapper topnav__inner">
        <%= link_to root_path, class: "topnav__brand", "aria-label": "Holistic Health — home" do %>
          <%= image_tag "/logo.svg", alt: "Holistic Health", height: 32, class: "topnav__logo" %>
        <% end %>
        <nav class="topnav__nav" aria-label="Site navigation">
          <ul class="topnav__links">
            <li><%= link_to "Home", root_path, class: "topnav__link" %></li>
            <li><%= link_to "Find a Specialist", root_path(anchor: "results"), class: "topnav__link" %></li>
            <% if Current.user&.admin? %>
              <li><%= link_to "Admin", admin_root_path, class: "topnav__link" %></li>
              <li><%= button_to "Sign out", session_path, method: :delete, class: "topnav__link topnav__link--button" %></li>
            <% elsif Current.user&.practitioner? %>
              <li><%= link_to "Dashboard", practitioner_root_path, class: "topnav__link" %></li>
              <li><%= button_to "Sign out", session_path, method: :delete, class: "topnav__link topnav__link--button" %></li>
            <% else %>
              <li><%= link_to "Sign in", new_session_path, class: "topnav__link topnav__link--pill" %></li>
            <% end %>
          </ul>
        </nav>
      </div>
    </header>

    <main>
      <%= render "shared/flash" %>
      <%= yield %>
    </main>
  </body>
</html>
