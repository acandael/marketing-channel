<%= form_with model: [:admin, specialty], class: "form" do |f| %>
  <% if specialty.errors.any? %>
    <div class="flash flash--alert">
      <strong><%= pluralize(specialty.errors.count, "error") %> prevented this from being saved:</strong>
      <ul style="margin-top: 8px; margin-left: 20px;"><% specialty.errors.full_messages.each do |m| %><li><%= m %></li><% end %></ul>
    </div>
  <% end %>

  <div class="form-section">
    <h2 class="form-section__title">Details</h2>
    <p class="form-section__hint">The slug is generated automatically from the name.</p>

    <div class="form-grid">
      <div class="form-field form-field--full">
        <%= f.label :name, class: "form-field__label" %>
        <%= f.text_field :name, class: "form-field__input", required: true, autofocus: true %>
      </div>
      <div class="form-field form-field--full">
        <%= f.label :description, class: "form-field__label" %>
        <%= f.text_area :description, class: "form-field__textarea", rows: 3 %>
        <span class="form-field__hint">Optional short explanation of the specialty.</span>
      </div>
      <div class="form-field form-field--full">
        <%= f.label :search_aliases, "Search aliases", class: "form-field__label" %>
        <%= f.text_area :search_aliases, class: "form-field__textarea", rows: 2 %>
        <span class="form-field__hint">Comma-separated synonyms visitors might search for (e.g. “chiropractor, chiro”).</span>
      </div>
    </div>
  </div>

  <div class="form-actions">
    <%= f.submit specialty.persisted? ? "Save changes" : "Create specialty", class: "btn btn--primary" %>
    <%= link_to "Cancel", admin_specialties_path, class: "btn btn--ghost" %>
  </div>
<% end %>
