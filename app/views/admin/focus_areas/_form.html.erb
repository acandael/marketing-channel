<%= form_with model: [:admin, focus_area], class: "form" do |f| %>
  <% if focus_area.errors.any? %>
    <div class="flash flash--alert">
      <strong><%= pluralize(focus_area.errors.count, "error") %> prevented this from being saved:</strong>
      <ul style="margin-top: 8px; margin-left: 20px;"><% focus_area.errors.full_messages.each do |m| %><li><%= m %></li><% end %></ul>
    </div>
  <% end %>

  <div class="form-section">
    <h2 class="form-section__title">Details</h2>
    <p class="form-section__hint">The slug is generated automatically from the name.</p>

    <div class="form-grid">
      <div class="form-field form-field--full">
        <%= f.label :name, class: "form-field__label" %>
        <%= f.text_field :name, class: "form-field__input", required: true, autofocus: true %>
      </div>
    </div>
  </div>

  <div class="form-actions">
    <%= f.submit focus_area.persisted? ? "Save changes" : "Create focus area", class: "btn btn--primary" %>
    <%= link_to "Cancel", admin_focus_areas_path, class: "btn btn--ghost" %>
  </div>
<% end %>
