<% content_for :title, "Practitioners" %>

<header class="page-header">
  <div>
    <h1 class="page-header__title">Practitioners</h1>
    <p class="page-header__subtitle">Seed profiles managed by the admin team.</p>
  </div>
  <%= link_to "New practitioner", new_admin_practitioner_path, class: "btn btn--primary" %>
</header>

<%= form_with url: admin_practitioners_path, method: :get, class: "filter-bar", local: true do |f| %>
  <div class="form-field">
    <%= f.label :q, "Search name", class: "form-field__label" %>
    <%= f.text_field :q, value: @filters[:q], class: "form-field__input", placeholder: "e.g. Schmidt" %>
  </div>
  <div class="form-field">
    <%= f.label :city, class: "form-field__label" %>
    <%= f.select :city, options_for_select([["Any city", ""]] + @cities.map { |c| [c, c] }, @filters[:city]), {}, class: "form-field__select" %>
  </div>
  <div class="form-field">
    <%= f.label :specialty_id, "Specialty", class: "form-field__label" %>
    <%= f.select :specialty_id, options_for_select([["Any specialty", ""]] + @specialties.map { |s| [s.name, s.id] }, @filters[:specialty_id]), {}, class: "form-field__select" %>
  </div>
  <div class="form-field">
    <%= f.label :status, class: "form-field__label" %>
    <%= f.select :status, options_for_select([["Any status", ""], ["Published", "published"], ["Unpublished", "unpublished"], ["Claimed", "claimed"], ["Unclaimed", "unclaimed"]], @filters[:status]), {}, class: "form-field__select" %>
  </div>
  <div class="filter-bar__actions">
    <%= f.submit "Filter", class: "btn btn--secondary" %>
    <%= link_to "Reset", admin_practitioners_path, class: "btn btn--ghost" %>
  </div>
<% end %>

<div data-controller="bulk-actions">
  <%= form_with url: "#", method: :patch, id: "bulk-actions-form", data: { bulk_actions_target: "form" } do |f| %>
    <div class="bulk-bar" data-bulk-actions-target="bar" role="region" aria-label="Bulk actions">
      <span class="bulk-bar__count"><span data-bulk-actions-target="count">0</span> selected</span>
      <%= button_tag "Publish", type: "submit", formaction: bulk_publish_admin_practitioners_path,
            formmethod: "patch",
            class: "btn btn--secondary btn--sm",
            data: { turbo_confirm: "Publish the selected practitioners?" } %>
      <%= button_tag "Unpublish", type: "submit", formaction: bulk_unpublish_admin_practitioners_path,
            formmethod: "patch",
            class: "btn btn--secondary btn--sm",
            data: { turbo_confirm: "Unpublish the selected practitioners?" } %>
      <%= button_tag "Delete", type: "submit", formaction: bulk_destroy_admin_practitioners_path,
            formmethod: "post",
            class: "btn btn--danger btn--sm",
            data: { turbo_confirm: "Permanently delete the selected practitioners?", turbo_method: :delete } %>
    </div>
  <% end %>

  <section class="table-card">
    <table class="table">
      <thead>
        <tr>
          <th class="table__checkbox">
            <input type="checkbox" data-action="change->bulk-actions#toggleAll" data-bulk-actions-target="toggleAll" aria-label="Select all">
          </th>
          <th><%= sort_link_to "Name", "name", params %></th>
          <th><%= sort_link_to "City", "city", params %></th>
          <th>Specialties</th>
          <th>Status</th>
          <th>Invitation</th>
          <th><%= sort_link_to "Updated", "updated_at", params %></th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% if @practitioners.any? %>
          <% @practitioners.each do |p| %>
            <%= render "row", practitioner: p %>
          <% end %>
        <% else %>
          <tr><td colspan="8" class="table__empty">No practitioners match those filters.</td></tr>
        <% end %>
      </tbody>
    </table>
    <% if @practitioners.any? %>
      <div class="pagination">
        <%== pagy_nav(@pagy) %>
      </div>
    <% end %>
  </section>
</div>
