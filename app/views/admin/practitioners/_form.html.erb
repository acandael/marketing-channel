<%= form_with model: [:admin, practitioner], class: "form" do |f| %>
  <% if practitioner.errors.any? %>
    <div class="flash flash--alert">
      <strong><%= pluralize(practitioner.errors.count, "error") %> prevented this from being saved:</strong>
      <ul style="margin-top: 8px; margin-left: 20px;"><% practitioner.errors.full_messages.each do |m| %><li><%= m %></li><% end %></ul>
    </div>
  <% end %>

  <div class="form-section">
    <h2 class="form-section__title">Identity</h2>
    <p class="form-section__hint">The basics that identify this practitioner.</p>

    <div class="form-grid">
      <div class="form-field">
        <%= f.label :salutation, class: "form-field__label" %>
        <%= f.select :salutation, [["—", ""]] + Practitioner::SALUTATIONS.map { |s| [s, s] }, {}, class: "form-field__select" %>
      </div>
      <div class="form-field">
        <%= f.label :full_name, class: "form-field__label" %>
        <%= f.text_field :full_name, class: "form-field__input", required: true %>
      </div>

      <div class="form-field form-field--full">
        <%= f.label :specialty_id, "Specialty", class: "form-field__label" %>
        <%= f.select :specialty_id,
              options_from_collection_for_select(Specialty.alphabetical, :id, :name, practitioner.specialty_id),
              { include_blank: "— None —" },
              class: "form-field__select" %>
        <% if Specialty.count.zero? %>
          <span class="form-field__hint">No specialties defined yet — <%= link_to "add one", new_admin_specialty_path %>.</span>
        <% end %>
      </div>

      <div class="form-field">
        <%= f.label :phone, class: "form-field__label" %>
        <%= f.text_field :phone, class: "form-field__input" %>
      </div>
      <div class="form-field">
        <%= f.label :public_email, "Public email", class: "form-field__label" %>
        <%= f.email_field :public_email, class: "form-field__input" %>
        <span class="form-field__hint">Shown on the public profile — distinct from login email.</span>
      </div>
      <div class="form-field form-field--full">
        <%= f.label :website_url, "Website", class: "form-field__label" %>
        <%= f.url_field :website_url, class: "form-field__input", placeholder: "https://…" %>
      </div>

      <div class="form-field form-field--full">
        <label class="row" style="gap: 8px;">
          <%= f.check_box :published %>
          <span><strong>Published</strong> — visible on the public directory once milestone 2 lands.</span>
        </label>
      </div>
    </div>
  </div>

  <div class="form-section">
    <h2 class="form-section__title">Practice address</h2>
    <p class="form-section__hint">Saved coordinates come from Nominatim geocoding. You can drag the pin below to correct them.</p>

    <div class="form-grid">
      <div class="form-field form-field--full">
        <%= f.label :street_address, "Street & house number", class: "form-field__label" %>
        <%= f.text_field :street_address, class: "form-field__input", placeholder: "e.g. Alexanderplatz 1" %>
      </div>
      <div class="form-field">
        <%= f.label :postal_code, "Postal code (PLZ)", class: "form-field__label" %>
        <%= f.text_field :postal_code, class: "form-field__input", pattern: "\\d{5}", inputmode: "numeric" %>
      </div>
      <div class="form-field">
        <%= f.label :city, class: "form-field__label" %>
        <%= f.text_field :city, class: "form-field__input", required: true %>
      </div>
      <div class="form-field form-field--full">
        <%= f.label :bundesland, class: "form-field__label" %>
        <%= f.select :bundesland, [["—", ""]] + Practitioner::BUNDESLAENDER.map { |b| [b, b] }, {}, class: "form-field__select" %>
      </div>

      <div class="form-field form-field--full">
        <%= render "map_preview", f: f, practitioner: practitioner %>
      </div>
    </div>
  </div>

  <div class="form-actions">
    <%= f.submit practitioner.persisted? ? "Save changes" : "Create practitioner", class: "btn btn--primary" %>
    <%= link_to "Cancel", admin_practitioners_path, class: "btn btn--ghost" %>
  </div>
<% end %>

<% if practitioner.persisted? %>
  <div class="form-actions" style="justify-content: flex-end;">
    <%= button_to "Delete", admin_practitioner_path(practitioner), method: :delete,
          class: "btn btn--danger",
          data: { turbo_confirm: "Delete #{practitioner.full_name}?" } %>
  </div>
<% end %>
